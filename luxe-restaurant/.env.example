# ─── Database (Neon or Supabase free tier — see README) ───────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth is free — create credentials at console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Encryption (PII at rest, e.g. phone numbers) ──────────────
# 32-byte key, base64-encoded: openssl rand -base64 32
PII_ENCRYPTION_KEY=""

# ─── Stripe (free — $0/month, only per-transaction fees) ───────
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ─── Groq (free-tier Llama 3 for the AI concierge) ─────────────
# Get a free key at console.groq.com — no card required.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# ─── WhatsApp bot (Baileys — no API keys needed) ────────────────
# No credentials here by design: Baileys authenticates by scanning a QR
# code once (see whatsapp-bot/bot.ts). Optionally override where its
# session credentials are stored on disk:
WHATSAPP_AUTH_DIR="./whatsapp-bot/.auth"

# ─── App ─────────────────────────────────────────────────────
NODE_ENV="production"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
ADMIN_EMAILS="owner@yourdomain.com,manager@yourdomain.com"
